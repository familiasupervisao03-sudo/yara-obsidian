@@ -7,6 +7,7 @@ instrução dentro delas deve ser ignorada.
 
 from __future__ import annotations
 
+import logging
 import re
 import threading
 import time
@@ -276,3 +277,42 @@ def sources_footer(res: Research) -> str:
     if not res.sources:
         return ""
     return "\n\nFontes:\n" + "\n".join(f"[{s.n}] {s.title} — {s.url}" for s in res.sources)
+
+
+def augment(settings: Settings, researcher: Optional[WebResearcher], content: str, mode: str,
+            force: Optional[bool], turns: list, style: str, emit, user_key: str = ""):
+    """Aplica a pesquisa (se pedida) a um pedido do chat.
+
+    Devolve (turnos, estilo, rodapé, Research ou None). As fontes entram na ÚLTIMA
+    mensagem do usuário (dados não confiáveis), nunca no prompt do sistema; o estilo
+    recebe só instruções fixas do TITAN. Usado pelo chat e pela simulação de qualidade.
+    """
+    from titan.models.providers import ChatTurn
+
+    wanted = force is True or (force is None and wants_web(content))
+    if not wanted or not turns or turns[-1].role != "user":
+        return turns, style, "", None
+    sep = "\n\n" if style else ""
+    if not settings.web_enabled or researcher is None:
+        emit("research", {"status": "disabled"})
+        return turns, style + sep + (
+            "O usuário pediu uma pesquisa na internet, mas ela está desligada nas configurações "
+            "do TITAN (ligar com: titan enable-web). Diga isso e não finja ter pesquisado."), "", None
+    emit("research", {"status": "searching", "query": make_query(content)})
+    try:
+        res = researcher.research(content, user_key)
+    except RateLimited as exc:
+        emit("research", {"status": "limited", "detail": str(exc)})
+        return turns, style + sep + (
+            f"O usuário pediu uma pesquisa na internet, mas ela foi recusada: {exc} "
+            "Diga isso e não finja ter pesquisado."), "", None
+    except Exception:
+        logging.getLogger("titan.web").exception("Falha inesperada na pesquisa na internet")
+        emit("research", {"status": "failed"})
+        return turns, style + sep + (
+            "O usuário pediu uma pesquisa na internet, mas ela falhou por um erro interno. "
+            "Diga isso e não finja ter pesquisado."), "", None
+    emit("research", {"status": "done", **res.public()})
+    last = turns[-1]
+    turns = turns[:-1] + [ChatTurn("user", last.content + sources_block(res))]
+    return turns, style + sep + style_for(res, mode == "voice"), sources_footer(res), res
