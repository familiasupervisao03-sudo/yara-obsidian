<?xml version="1.0" encoding="utf-8"?>
<!-- TITAN Central: a tela da nave na TV. Abre direto em /central, tela sempre acesa.
     Também aparece no menu das TVs com Android TV (leanback); controle remoto e toque são opcionais. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:banner="@drawable/banner">
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
