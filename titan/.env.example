# TITAN — configuração de exemplo. Copie para .env e ajuste.
# NUNCA coloque segredos reais neste arquivo (ele é versionado).

# --- Implantação local (privacidade máxima) ---
TITAN_ENV=development
TITAN_DEPLOYMENT_MODE=local
TITAN_LOCAL_ONLY=true

# --- Rede ---
# 127.0.0.1 = somente o notebook. Para o celular na Wi-Fi, veja docs/setup.md.
TITAN_HOST=127.0.0.1
TITAN_PORT=8000
TITAN_ALLOWED_NETWORKS=127.0.0.1/32,::1/128

# --- Banco de dados ---
# SQLite (padrão, leve). PostgreSQL: postgresql+psycopg://usuario:senha@127.0.0.1:5432/titan
DATABASE_URL=sqlite:///./var/titan.db
TITAN_DATA_DIR=./var
TITAN_WORKSPACE_ROOT=./var/workspaces

# --- Autenticação ---
# Gere um valor real com: python -m titan.cli gen-secret
TITAN_AUTH_SECRET=troque-este-valor-por-um-segredo-local-de-64-caracteres
TITAN_SESSION_TTL_HOURS=12
TITAN_COOKIE_SECURE=false

# --- Sandbox (Fase 3; execução de código desativada até validação) ---
# Pesquisa na internet: desligada. Ligar com: .venv/bin/titan enable-web
# (exige TITAN_LOCAL_ONLY=false; ver docs/pesquisa-internet.md)
TITAN_WEB_ENABLED=false
# SearXNG local opcional (sh scripts/install_searxng.sh). Vazio = Wikipédia.
TITAN_WEB_SEARXNG_URL=

TITAN_SANDBOX_ENABLED=false
TITAN_SANDBOX_NETWORK=false
TITAN_MAX_RUNTIME_SECONDS=30
TITAN_MAX_REPAIR_ATTEMPTS=3

# --- Modelos de IA ---
# none = sem modelo. Adaptadores locais (ollama, llamacpp) chegam na Fase 4.
TITAN_MODEL_PROVIDER=none
TITAN_MODEL_NAME=
TITAN_ALLOW_EXTERNAL_MODELS=false

# --- Orçamento (obrigatório: R$ 0/dia, aplicado pelo backend) ---
TITAN_ALLOW_PAID_APIS=false
TITAN_DAILY_PAID_BUDGET_BRL=0

# --- Logs (rotação com limite de tamanho) ---
TITAN_LOG_LEVEL=INFO
TITAN_LOG_MAX_BYTES=1000000
TITAN_LOG_BACKUP_COUNT=3

# --- Anthropic (EXTERNA e PAGA; desligada) ---
# Não edite à mão: use  sh scripts/enable_anthropic.sh  (ver docs/anthropic.md).
# TITAN_USD_BRL_RATE=
# TITAN_MODEL_MAX_OUTPUT_TOKENS=2048
# TITAN_MODEL_EFFORT=low
# ANTHROPIC_API_KEY=
